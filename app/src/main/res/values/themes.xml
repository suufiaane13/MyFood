<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MyFoodOrdering" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFF8F8F8</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <!-- Splash screen système Android 12+ -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#FFFFFF</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/logo</item>
    </style>

    <style name="Theme.MyFoodOrdering" parent="Base.Theme.MyFoodOrdering" />
</resources>